<Project Sdk="Microsoft.NET.Sdk">

  <!--
    grpc-dotnet against the GrpcAsm engine: Grpc.Net.Client, a client stack that shares no code
    with GrpcAsm, calls samples/Greeter (helloworld.Greeter/SayHello and the built-in health
    service). The Greeter runs in a stock debian:bookworm-slim container (glibc 2.36; the
    Greeter needs 2.34+), started through Testcontainers with the freshly built binary copied in,
    so the tests always exercise this tree's engine. Build the solution first
    (dotnet build GrpcAsm.slnx -c Release): GreeterServer locates
    samples/Greeter/bin/Release/libc/greeter, or GREETER_BINARY when set.

    The other direction too (ClientInteropTests): GrpcAsm's client, as the NASM sample
    samples/GreeterClient, calls a Greeter that ASP.NET Core (Kestrel, Grpc.AspNetCore) serves in
    the test process, through Testcontainers' host port forwarding.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit.v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GrpcAsm.Greeter.Interop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core's shared framework: Kestrel and Grpc.AspNetCore serve the Greeter that
         GrpcAsm's client calls in ClientInteropTests (this SDK is not the Web SDK). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.HealthCheck" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both sides: the client stubs call the assembly Greeter (GreeterInteropTests), and the
         server base class serves the Greeter that GrpcAsm's client calls (ClientInteropTests). -->
    <Protobuf Include="Protos\helloworld.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
