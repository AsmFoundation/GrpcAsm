<Project>
  <!--
    Central package management for GrpcAsm's .NET test projects: one version per dependency.
    The versions match KvAsm's client solution (AsmFoundation/KvAsm client/dotnet), so both
    repositories test against the same grpc-dotnet. Grpc.* packages move in lockstep and must
    share a version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <!-- The server side of grpc-dotnet (Kestrel), for the client's interop tests: GrpcAsm's
         client calls a Greeter that ASP.NET Core serves in the test process. -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.HealthCheck" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <!-- Runs on Microsoft.Testing.Platform (opted in via global.json), so the VSTest bridge
         packages (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio) are deliberately absent. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
