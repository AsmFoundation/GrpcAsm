<Project Sdk="AsmFoundation.Sdk">
  <!--
    libgrpcasm.so: GrpcAsm's C ABI (include/grpcasm.h), the engine plus an adapter (capi.asm)
    that is an application of it: the adapter defines the engine's hooks and route table, fills
    them from handlers registered at run time, and exports grpcasm_* functions. C, .NET
    (P/Invoke) and Python (ctypes) programs use the engine through it.

    Linked with -Bsymbolic and a version script (grpcasm.map): only grpcasm.h's functions are
    exported (GRPCASM_0.1), and every internal reference binds inside the library, so a host's
    own symbols can never interpose on the engine's.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>libc</TargetFramework>
    <AssemblyName>grpcasm</AssemblyName>
    <!-- Not the engine's grpcasm: NuGet needs distinct project names (see GrpcAsm.asmproj). -->
    <PackageId>GrpcAsm.Native</PackageId>
    <!-- The version script, under NativeAOT's name for it: only grpcasm.h's functions stay
         exported, as grpcasm_*@@GRPCASM_0.1. Editing it relinks. -->
    <ExportsFile>grpcasm.map</ExportsFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every reference inside the library binds to the library itself. -->
    <LinkerArg Include="-Bsymbolic" />
    <ProjectReference Include="../GrpcAsm/GrpcAsm.asmproj" />
  </ItemGroup>
</Project>
