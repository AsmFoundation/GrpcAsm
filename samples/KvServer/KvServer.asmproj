<Project Sdk="AsmFoundation.Sdk">
  <!--
    KvServer: KvAsm's key-value service (store, cuckoo table, snapshot, the KV half of the gRPC
    layer, configuration and main) as an application of the GrpcAsm engine. It is the reference
    consumer for milestone B: KvAsm's whole end-to-end suite (h2spec, the fuzzer, every itest
    phase) runs against this binary after every extraction step, so a step that changes
    behavior fails a test instead of passing unnoticed.

    Runs on glibc (TargetFramework=libc): main() is entered through AsmFoundation.Sdk's crt1, like
    KvAsm's own server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>libc</TargetFramework>
    <AssemblyName>kvserver</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/GrpcAsm/GrpcAsm.asmproj" />
  </ItemGroup>
</Project>
