<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GreeterNet: C# services on GrpcAsmServer: the HTTP/2, HPACK, gRPC call layer and event loops
    are GrpcAsm's assembly engine (libgrpcasm.so), the handlers are C#.

    By default it hosts the C# service classes of samples/Greeter.Service, unchanged: the same
    GreeterService and OrdersService that samples/GreeterAspNet hosts on ASP.NET Core, bound with
    one line each through GrpcAsmServer.ServiceBinder. benchmarks/endtoend/2026-11-20-aspnet
    measures the two servers side by side.

    helloworld.Greeter/SayHello answers as samples/Greeter (NASM) and samples/GreeterC (C) do,
    with the same settings, log lines and exit codes: tests/greeter_net.sh runs the Greeters'
    suite on it in every mode. benchmarks/endtoend/2026-11-18-dotnet measured what an inline
    .NET handler costs per call.

    GREETER_PORT (1..65535, default 50051), GREETER_WORKERS (1..256, default 1), GREETER_MODE,
    how SayHello is written:
      service  (default) GreeterService through GrpcAsmServer.ServiceBinder: your grpc-dotnet
               class, its marshallers and a ServerCallContext per call
      typed    a Func<HelloRequest, HelloReply> (GrpcAsmServer.AddUnary<,>): Google.Protobuf
      raw      a span handler: GrpcAsmProtobuf finds the name in place, the reply framed by hand
    shop.Orders/Place is OrdersService through the binder in every mode. Stops on SIGTERM or
    SIGINT and logs the server's totals. Linux x64 (libgrpcasm.so); to run it in another Linux
    image, publish it self-contained: dotnet publish -c Release -r linux-x64 (tests/greeter_net.sh
    does).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No ICU: the sample formats nothing culture-specific, and a self-contained publish then
         runs in any glibc image (the benchmarks run it next to h2load in kvasm-toolchain). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GrpcAsm.Net/GrpcAsm.Net.csproj" />
    <!-- The C# services and their messages (helloworld, shop), shared with GreeterAspNet. -->
    <ProjectReference Include="../Greeter.Service/Greeter.Service.csproj" />
  </ItemGroup>
</Project>
